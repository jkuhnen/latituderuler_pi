<?xml version="1.0" encoding="UTF-8"?>
<plugin version="1">
  <name>Latitude Ruler</name>
  <version>@PACKAGE_VERSION@</version>
  <release>0</release>
  <summary>Latitude scale on the left edge of the OpenCPN chart</summary>

  <api-version>@OCPN_API_VERSION@</api-version>
  <open-source>yes</open-source>
  <author>Johannes Kuhnen</author>
  <source>https://github.com/jkuhnen/latituderuler_pi</source>

  <description>
    Adds a compact nautical latitude ruler to the left side of the chart canvas. Tick spacing adapts automatically to zoom level and follows the active viewport.
  </description>

  <target>@OCPN_PACKAGE_TARGET@</target>
  <build-target>@OCPN_BUILD_TARGET@</build-target>
  <target-version>@OCPN_TARGET_VERSION@</target-version>
  <target-arch>@OCPN_TARGET_ARCH@</target-arch>
  <info-url>https://github.com/jkuhnen/latituderuler_pi</info-url>
</plugin>
